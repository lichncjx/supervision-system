# 复制为 .env.production 后修改。不要把正式密码提交到代码仓库。

NODE_ENV=production

# PostgreSQL 容器初始化密码，必须与下方连接字符串中的密码一致。
POSTGRES_PASSWORD=请修改数据库密码
DATABASE_URL=postgresql://supervision:请修改数据库密码@db:5432/supervision?schema=public
DIRECT_URL=postgresql://supervision:请修改数据库密码@db:5432/supervision?schema=public

# 应用长期运行配置。JWT_SECRET 必须使用足够长的随机字符串。
JWT_SECRET=请修改JWT密钥
NEXT_PUBLIC_APP_URL=http://服务器内网IP:5000

# 管理员初始密码不写入本文件，由 install.sh 临时读取并只传给一次性 ops 容器。
