# 复制为 .env.production 后修改。不要把正式密码提交到代码仓库。

NODE_ENV=production

# PostgreSQL 容器初始化密码。必须与 DATABASE_URL / DIRECT_URL 中的密码保持一致。
POSTGRES_PASSWORD=

DATABASE_URL=postgresql://supervision:请修改数据库密码@db:5432/supervision?schema=public
DIRECT_URL=postgresql://supervision:请修改数据库密码@db:5432/supervision?schema=public

# 当前项目登录态使用 JWT_SECRET；NEXTAUTH_* 预留给后续如接入 NextAuth 时使用。
JWT_SECRET=
NEXT_PUBLIC_APP_URL=http://服务器内网IP:5000
NEXTAUTH_URL=http://服务器内网IP:5000
NEXTAUTH_SECRET=

# 正式内网首次初始化必须设置，首次登录后必须立即修改初始密码。
INITIAL_ADMIN_PASSWORD=
INITIAL_SUPERVISOR_PASSWORD=
